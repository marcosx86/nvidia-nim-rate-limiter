# =============================================================================
# NVIDIA NIM Rate Limiter & Observability Proxy — Environment Configuration
# =============================================================================
# Copy this file to `.env` and set your real NVIDIA API key:
#   cp .env.example .env
#
# Precedence order (highest to lowest):
#   CLI arguments (argparse) > Environment Variables > .env (dotenv) > config.yaml > Defaults
#
# Security: Never commit `.env` or any file containing real `nvapi-*` credentials.
# =============================================================================

# -----------------------------------------------------------------------------
# Required Credentials
# -----------------------------------------------------------------------------
# Raw NVIDIA Build / NIM API key from https://build.nvidia.com/
# Startup fails fast if this variable is missing or empty.
NVIDIA_API_KEY=nvapi-YOUR_REAL_KEY_HERE

# -----------------------------------------------------------------------------
# Server Bind & Trial Guardrails
# -----------------------------------------------------------------------------
# Bind host when launched via `python app.py` (default: 127.0.0.1 for loopback safety)
# HOST=127.0.0.1

# Bind port when launched via `python app.py` (default: 8000)
# PORT=8000

# Allow binding to non-loopback interfaces such as 0.0.0.0 (default: false)
# Set to true when intentionally running behind Docker port mapping.
# ALLOW_NON_LOCAL_BIND=false

# Fail fast instead of warning on unsafe non-local bind configurations (default: false)
# STRICT_TRIAL_GUARDRAILS=false

# -----------------------------------------------------------------------------
# Upstream Proxy & Concurrency
# -----------------------------------------------------------------------------
# Base URL of the upstream NVIDIA NIM API (default: https://integrate.api.nvidia.com)
# UPSTREAM_URL=https://integrate.api.nvidia.com

# Deployment mode classification: auto, trial, self_hosted, or partner (default: auto)
# DEPLOYMENT_MODE=auto

# Seconds to cache GET /v1/models catalog responses; 0 disables caching (default: 300.0)
# CATALOG_CACHE_TTL=300.0

# Reject unknown models with HTTP 404 when catalog cache is active (default: false)
# ENFORCE_CATALOG=false

# Maximum simultaneous in-flight upstream requests (default: 1)
# Keep at 1 for Hermes / agent loops to prevent saturating free-tier quotas.
# MAX_CONCURRENT=1

# -----------------------------------------------------------------------------
# Rate Limiting, TPM Budgeting & Quota Caps
# -----------------------------------------------------------------------------
# Allowed requests per rate-limit window (default: 6.0)
# RPM=6.0

# Duration of the rate-limit window in seconds (default: 60.0)
# WINDOW_SECONDS=60.0

# Maximum token bucket burst capacity (default: 6.0)
# BURST_CAPACITY=6.0

# Tokens-Per-Minute (TPM) limit across prompt + completion tokens (0 = disabled, default: 0)
# TPM=0

# Maximum seconds a queued request will wait before failing fast with local HTTP 429
# (0 = wait indefinitely, default: 0.0)
# MAX_WAIT_SECONDS=0.0

# Maximum allowed requests per UTC day before tripping local HTTP 429 (0 = disabled, default: 0)
# DAILY_REQUEST_CAP=0

# Maximum allowed LLM tokens per UTC day before tripping local HTTP 429 (0 = disabled, default: 0)
# DAILY_TOKEN_CAP=0

# -----------------------------------------------------------------------------
# Storage, Config Persistence & Admin Dashboard
# -----------------------------------------------------------------------------
# Path to SQLite request log database (default: limiter.db)
# DB_PATH=limiter.db

# Path to persisted non-secret YAML configuration (default: config.yaml)
# CONFIG_FILE=config.yaml

# Path to dotenv fallback file (default: .env)
# ENV_FILE=.env

# Directory serving static Web Admin Dashboard assets (default: wwwroot)
# WWWROOT_DIR=wwwroot

# Title displayed in the /admin/ Web Dashboard (default: NVIDIA NIM Rate Limiter Dashboard)
# ADMIN_TITLE=NVIDIA NIM Rate Limiter Dashboard
